# Copy to .env.local and fill in. Values come from Firebase console →
# Project settings → Your apps → Web app config. They are public identifiers;
# access is enforced by firestore.rules / storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cephvision.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cephvision
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional external API (axios client in config/client.ts)
NEXT_PUBLIC_API_BASE_URL=

# Server-only secrets (already set up in CI/CD)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ENDPOINT=
GEMINI_API_KEY=
