rules_version = '2';

// Layout: see services/data/paths.ts
// Files are private to the clinician who uploaded them. Uploads get a fresh
// ID each time, so existing files are never overwritten, and the app cannot
// delete them (erasure requests are handled with admin tooling).

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Storage treats overwriting a file's contents as "create", so check
    // explicitly that nothing exists at the path yet.
    function isNewFile() {
      return resource == null;
    }

    function maxSize() {
      return request.resource.size < 20 * 1024 * 1024;
    }

    match /users/{uid}/patients/{patientId}/studies/{studyId} {
      match /radiograph/{fileName} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isNewFile()
          && maxSize()
          && request.resource.contentType.matches('image/(jpeg|png)');
        allow update, delete: if false;
      }

      match /reports/{fileName} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isNewFile()
          && maxSize()
          && request.resource.contentType == 'application/pdf'
          && fileName.matches('.*[.]pdf');
        allow update, delete: if false;
      }
    }

    // Anything else is denied.
  }
}
